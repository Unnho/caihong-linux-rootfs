#
# ROCKNIX is a Buildroot-based distribution.  Its SM8650 release ships the
# complete userspace as a squashfs SYSTEM payload, so the image builder
# unpacks that payload, installs the Caihong kernel modules and platform
# runtime, and repacks the result as a direct-root ext4 image that boots from
# the same Android boot images as the Arch Linux ARM and Armada images.
#
# The release and checksum are pinned so an image build is reproducible.  Bump
# both values together after testing a new ROCKNIX release.
: "${ROCKNIX_SOC:=SM8650}"
: "${ROCKNIX_RELEASE:=20261101}"
: "${ROCKNIX_IMAGE_NAME:=ROCKNIX-${ROCKNIX_SOC}.aarch64-${ROCKNIX_RELEASE}.tar}"
: "${ROCKNIX_IMAGE_SHA256:=bc42cc957a035d7a85b57855c00cfa2087dffab47de9897380ee35ff39c5daa0}"
: "${ROCKNIX_DOWNLOAD_BASE:=https://github.com/ROCKNIX/distribution/releases/download/${ROCKNIX_RELEASE}}"
: "${ROCKNIX_IMAGE_URL:=${ROCKNIX_DOWNLOAD_BASE}/${ROCKNIX_IMAGE_NAME}}"
export ROCKNIX_DOWNLOAD_BASE ROCKNIX_IMAGE_NAME ROCKNIX_IMAGE_SHA256 ROCKNIX_IMAGE_URL ROCKNIX_RELEASE ROCKNIX_SOC
