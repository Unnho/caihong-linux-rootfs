#
# Debian userspace for Caihong.  The rootfs is assembled with mmdebstrap from
# the official Debian archive; the kernel and device payload come from this
# repository as native .deb packages.  Override the suite when a newer stable
# release lands, then rebuild the kernel and platform packages with it.
: "${DEBIAN_SUITE:=trixie}"
: "${DEBIAN_MIRROR:=http://deb.debian.org/debian}"
: "${DEBIAN_SECURITY_MIRROR:=http://security.debian.org/debian-security}"
: "${DEBIAN_COMPONENTS:=main contrib non-free non-free-firmware}"
: "${DEBIAN_ARCH:=arm64}"
# Desktop account created in the image.  It replaces Arch's "alarm" and
# Armada's "armada" accounts; the platform payload is adapted to it.
: "${DEBIAN_ACCOUNT:=caihong}"
export DEBIAN_ACCOUNT DEBIAN_ARCH DEBIAN_COMPONENTS DEBIAN_MIRROR DEBIAN_SECURITY_MIRROR DEBIAN_SUITE
