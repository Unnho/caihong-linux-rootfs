[Unit]
Description=Caihong automatic Bluetooth keyboard compatibility
After=dbus.service bluetooth.service
Requires=dbus.service
ConditionPathExists=/proc/device-tree/compatible
# The service talks to BlueZ through PyGObject.  Distributions that ship the
# Python module without GObject typelibs (ROCKNIX) cannot run it; skip the unit
# there instead of restarting it forever.  Probing the import also covers the
# multiarch typelib directory Debian installs.
ExecCondition=/usr/bin/python3 -c "from gi.repository import Gio"

[Service]
Type=dbus
BusName=org.caihong.Keyboard1
ExecStart=/usr/local/sbin/caihong-keyboard
StateDirectory=caihong-keyboard
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/sys
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
